cmake_minimum_required(VERSION 3.25)
if(NOT CMAKE_HOST_WIN32 OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Native Windows host and OUTPUT_DIR are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(archive "${OUTPUT_DIR}/mingw.7z")
if(NOT EXISTS "${archive}")
    file(DOWNLOAD https://github.com/niXman/mingw-builds-binaries/releases/download/13.2.0-rt_v11-rev1/x86_64-13.2.0-release-win32-seh-msvcrt-rt_v11-rev1.7z
        "${archive}" TLS_VERIFY ON STATUS download_status)
    list(GET download_status 0 download_result)
    if(NOT download_result EQUAL 0)
        message(FATAL_ERROR "Toolchain download failed: ${download_status}")
    endif()
endif()
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${OUTPUT_DIR}")
execute_process(COMMAND "${OUTPUT_DIR}/mingw64/bin/gcc.exe" -dumpfullversion
    RESULT_VARIABLE status OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR NOT version STREQUAL "13.2.0")
    message(FATAL_ERROR "Fixed native Windows compiler did not execute: ${status}: ${version}")
endif()
message(STATUS "Fixed Windows GCC, Win32 threads, SEH and MSVCRT toolchain prepared")
