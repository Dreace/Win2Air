file(ARCHIVE_EXTRACT INPUT "${gettext_archive}" DESTINATION "${BUILD_DIR}/tools/gettext")
function(prepare name url)
    file(MAKE_DIRECTORY "${ARCHIVE_DIR}" "${BUILD_DIR}/sources/${name}")
    set(archive "${ARCHIVE_DIR}/${name}.tar")
    if(NOT EXISTS "${archive}")
        file(DOWNLOAD "${url}" "${archive}" TLS_VERIFY ON STATUS download_status)
        list(GET download_status 0 download_result)
        if(NOT download_result EQUAL 0)
            message(FATAL_ERROR "Dependency download failed: ${name}: ${download_status}")
        endif()
    endif()
    if(NOT RESUME)
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${BUILD_DIR}/sources/${name}")
    endif()
    file(GLOB roots "${BUILD_DIR}/sources/${name}/*")
    list(LENGTH roots count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Unexpected native dependency archive layout: ${name}")
    endif()
    list(GET roots 0 source)
    set_property(GLOBAL PROPERTY "source_${name}" "${source}")
endfunction()
function(run directory)
    get_property(operation_id GLOBAL PROPERTY native_operation_id)
    if(NOT operation_id)
        set(operation_id 0)
    endif()
    math(EXPR operation_id "${operation_id}+1")
    set_property(GLOBAL PROPERTY native_operation_id "${operation_id}")
    if("check" IN_LIST ARGN)
        set(operation_id check)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "PATH=${TOOLCHAIN_DIR}/bin;${BUILD_DIR}/tools/gettext/bin;E:/Environment/strawberryperl/perl/bin;C:/Program Files/Git/usr/bin;$ENV{PATH}"
        "CC=gcc" "CXX=g++" "MAKE=mingw32-make" "SHELL=${shell}"
        "CPPFLAGS=-I${prefix}/include" "LDFLAGS=-L${prefix}/lib" ${ARGN}
        WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status
        OUTPUT_FILE "${directory}/native.stdout.log" ERROR_FILE "${directory}/native.stderr.log" TIMEOUT 1800)
    file(COPY_FILE "${directory}/native.stdout.log" "${directory}/native.${operation_id}.stdout.log")
    file(COPY_FILE "${directory}/native.stderr.log" "${directory}/native.${operation_id}.stderr.log")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Native dependency operation failed: ${ARGN}: ${status}; logs=${directory}/native.stdout.log and native.stderr.log")
    endif()
endfunction()
function(build name)
    if(NOT name IN_LIST DEPENDENCIES)
        return()
    endif()
    get_property(directory GLOBAL PROPERTY "source_${name}")
    if(NOT EXISTS "${directory}/configure")
        message(FATAL_ERROR "Missing frozen dependency sources: ${directory}")
    endif()
    message(STATUS "Configuring and compiling with native Windows GCC: ${name}")
    if(NOT RESUME OR NOT EXISTS "${directory}/config.status")
        run("${directory}" "${shell}" ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32
            "--prefix=${prefix}" --disable-shared --enable-static ${ARGN})
        run("${directory}" "${make}" "SHELL=${shell}" clean)
    endif()
    run("${directory}" "${make}" "SHELL=${shell}" -j4)
    run("${directory}" "${make}" "SHELL=${shell}" check)
    run("${directory}" "${make}" "SHELL=${shell}" install)
endfunction()
prepare(gpg-error-1.43 https://gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-1.43.tar.bz2)
prepare(gcrypt-1.9.4 https://gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.9.4.tar.bz2)
prepare(sodium-1.0.18 https://download.libsodium.org/libsodium/releases/old/libsodium-1.0.18.tar.gz)
prepare(event-2.1.12 https://github.com/libevent/libevent/releases/download/release-2.1.12-stable/libevent-2.1.12-stable.tar.gz)
prepare(plist-2.2.0 https://github.com/libimobiledevice/libplist/releases/download/2.2.0/libplist-2.2.0.tar.bz2)
prepare(ffmpeg-4.4.2 https://ffmpeg.org/releases/ffmpeg-4.4.2.tar.xz)
get_property(gpg_source GLOBAL PROPERTY source_gpg-error-1.43)
set(test_adapter "${CMAKE_CURRENT_LIST_DIR}/gpg-error-native-tests.patch")
execute_process(COMMAND git -c core.autocrlf=false apply --check --unidiff-zero "${test_adapter}"
    WORKING_DIRECTORY "${gpg_source}" RESULT_VARIABLE adapter_status OUTPUT_QUIET ERROR_QUIET)
if(adapter_status EQUAL 0)
    if(EXISTS "${gpg_source}/native.stdout.log")
        file(COPY_FILE "${gpg_source}/native.stdout.log" "${gpg_source}/unadapted-tests.stdout.log")
        file(COPY_FILE "${gpg_source}/native.stderr.log" "${gpg_source}/unadapted-tests.stderr.log")
    endif()
    execute_process(COMMAND git -c core.autocrlf=false apply --unidiff-zero "${test_adapter}"
        WORKING_DIRECTORY "${gpg_source}" COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND git -c core.autocrlf=false apply --reverse --check --unidiff-zero "${test_adapter}"
        WORKING_DIRECTORY "${gpg_source}" COMMAND_ERROR_IS_FATAL ANY)
endif()
build(gpg-error-1.43 --disable-nls --disable-doc)
build(gcrypt-1.9.4 --disable-doc "--with-libgpg-error-prefix=${prefix}")
build(sodium-1.0.18)
build(event-2.1.12 --disable-openssl --disable-samples)
build(plist-2.2.0 --without-cython)
