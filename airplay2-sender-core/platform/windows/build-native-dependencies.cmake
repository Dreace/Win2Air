    --disable-avformat --disable-avfilter --disable-avdevice --disable-swscale --disable-swresample --disable-network --disable-x86asm
    --enable-encoder=alac --enable-decoder=alac)
run("${ffmpeg}" "${make}" "SHELL=${shell}" clean)
run("${ffmpeg}" "${make}" "SHELL=${shell}" -j4)
run("${ffmpeg}" "${make}" "SHELL=${shell}" install)
endif()
