cmake_minimum_required(VERSION 3.25)
if(NOT CMAKE_HOST_WIN32 OR NOT DEFINED BUILD_DIR OR NOT DEFINED TOOLCHAIN_DIR)
    message(FATAL_ERROR "Native Windows dependency verification requires BUILD_DIR and TOOLCHAIN_DIR")
endif()
set(shell "C:/Progra~1/Git/usr/bin/bash.exe")
set(make "${TOOLCHAIN_DIR}/bin/mingw32-make.exe")
set(prefix "${BUILD_DIR}/prefix")
execute_process(COMMAND "${TOOLCHAIN_DIR}/bin/gcc.exe" -dumpfullversion
    RESULT_VARIABLE status OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR NOT version STREQUAL "13.2.0")
    message(FATAL_ERROR "Native compiler differs from the frozen GCC version: ${status}: ${version}")
endif()
set(check_id check)
set(environment "{\"system\":\"Windows\",\"architecture\":\"x86_64\",\"compiler\":\"GCC 13.2.0\",\"runtime\":\"MSVCRT\",\"cross_compiling\":false,\"dependency_tests\":\"passed\",\"dependencies\":[]}")
set(index 0)
foreach(name gpg-error-1.43 gcrypt-1.9.4 sodium-1.0.18 event-2.1.12 plist-2.2.0)
    file(GLOB roots "${BUILD_DIR}/sources/${name}/*")
    list(LENGTH roots count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Dependency source directory differs: ${name}")
    endif()
    list(GET roots 0 source)
    set(test_log "${source}/native.${check_id}.stdout.log")
    file(READ "${test_log}" tests)
    if(tests MATCHES "(^|\n)FAIL:|(^|\n)ERROR:|[1-9][0-9]* tests failed")
        message(FATAL_ERROR "Original native dependency tests failed: ${name}")
    endif()
    if(NOT tests MATCHES "All [1-9][0-9]* tests passed|# PASS:[ ]*[1-9][0-9]*|[1-9][0-9]* tests ok|[1-9][0-9]* tests passed")
        message(FATAL_ERROR "Original dependency tests lack nonzero success evidence: ${name}")
    endif()
    if(name STREQUAL "event-2.1.12")
        string(FIND "${tests}" "WIN32 " backend_start)
        string(FIND "${tests}" "PASS: test_runner_win32" backend_end)
        if(backend_start LESS 0 OR backend_end LESS backend_start)
            message(FATAL_ERROR "Original Libevent Windows backend did not execute successfully")
        endif()
        math(EXPR backend_length "${backend_end}-${backend_start}")
        string(SUBSTRING "${tests}" ${backend_start} ${backend_length} backend)
        string(FIND "${backend}" "regress_debug:" debug_start)
        if(NOT backend MATCHES "regress: OKAY" OR debug_start LESS 0 OR backend MATCHES "Skipping test")
            message(FATAL_ERROR "Original Libevent Windows regression was skipped or failed")
        endif()
        string(SUBSTRING "${backend}" ${debug_start} -1 debug_backend)
        if(NOT debug_backend MATCHES "OKAY")
            message(FATAL_ERROR "Original Libevent Windows debug regression failed")
        endif()
    endif()
    file(READ "${source}/config.log" configuration)
    string(FIND "${configuration}" "checking whether we are cross compiling" cross_position)
    if(cross_position LESS 0)
        message(FATAL_ERROR "Native dependency configure check is missing: ${name}")
    endif()
    string(SUBSTRING "${configuration}" ${cross_position} -1 cross_check)
    string(REGEX MATCH "result: ([^\r\n]+)" unused "${cross_check}")
    if(NOT CMAKE_MATCH_1 STREQUAL "no")
        message(FATAL_ERROR "Dependency configure is not native: ${name}")
    endif()
    string(JSON environment SET "${environment}" dependencies ${index}
        "{\"name\":\"${name}\",\"test_command\":\"mingw32-make check\",\"result\":\"passed\"}")
    math(EXPR index "${index}+1")
endforeach()
file(GLOB roots "${BUILD_DIR}/sources/ffmpeg-4.4.2/*")
list(GET roots 0 ffmpeg)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "PATH=${TOOLCHAIN_DIR}/bin;E:/Environment/strawberryperl/perl/bin;C:/Program Files/Git/usr/bin;$ENV{PATH}"
    "SHELL=${shell}" "${make}" "SHELL=${shell}" -j4 fate-hmac fate-sha fate-sha512 fate-parseutils
    WORKING_DIRECTORY "${ffmpeg}" RESULT_VARIABLE status
    OUTPUT_FILE "${ffmpeg}/native.fate.stdout.log" ERROR_FILE "${ffmpeg}/native.fate.stderr.log" TIMEOUT 180)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Original native FFmpeg FATE failed: ${status}; logs=${ffmpeg}/native.fate.stdout.log and native.fate.stderr.log")
endif()
file(READ "${ffmpeg}/native.fate.stdout.log" fate)
foreach(name hmac sha sha512 parseutils)
    if(NOT fate MATCHES "TEST[ ]+${name}")
        message(FATAL_ERROR "Original FFmpeg check did not execute: ${name}")
    endif()
endforeach()
string(JSON environment SET "${environment}" dependencies ${index}
    "{\"name\":\"ffmpeg-4.4.2\",\"result\":\"passed\",\"test_command\":\"mingw32-make fate-hmac fate-sha fate-sha512 fate-parseutils\"}")
string(JSON environment SET "${environment}" test_environment_adapter
    "{\"library\":\"libgpg-error 1.43\",\"changes\":\"test-only native HANDLE pipe setup and normalized expected home path; original assertions retained; library source unchanged\"}")
file(WRITE "${prefix}/native-validation.json" "${environment}\n")
message(STATUS "Native fixed dependencies and original dependency tests verified")
