set(AIRPLAY2_WINDOWS_DEPENDENCIES "" CACHE PATH "Fixed Windows dependency installation")
if(NOT IS_DIRECTORY "${AIRPLAY2_WINDOWS_DEPENDENCIES}/include")
    message(FATAL_ERROR "Set AIRPLAY2_WINDOWS_DEPENDENCIES to the verified static dependency installation")
endif()
file(READ "${AIRPLAY2_WINDOWS_DEPENDENCIES}/native-validation.json" native_validation)
string(JSON native_status GET "${native_validation}" dependency_tests)
string(JSON native_cross GET "${native_validation}" cross_compiling)
if(NOT native_status STREQUAL "passed" OR native_cross)
    message(FATAL_ERROR "Windows dependencies require successful native compilation and original tests")
endif()
foreach(group PLATFORM PROTOCOL)
    add_library(PkgConfig::${group} INTERFACE IMPORTED)
    set_property(TARGET PkgConfig::${group} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${AIRPLAY2_WINDOWS_DEPENDENCIES}/include")
endforeach()
foreach(name event sodium gcrypt gpg-error plist-2.0 avcodec avutil)
    unset(dependency_${name} CACHE)
    find_library(dependency_${name} NAMES ${name} PATHS "${AIRPLAY2_WINDOWS_DEPENDENCIES}/lib" NO_DEFAULT_PATH REQUIRED NO_CACHE)
endforeach()
set_property(TARGET PkgConfig::PLATFORM PROPERTY INTERFACE_LINK_LIBRARIES "${dependency_event};${dependency_sodium}")
set_property(TARGET PkgConfig::PROTOCOL PROPERTY INTERFACE_LINK_LIBRARIES
    "${dependency_event};${dependency_gcrypt};${dependency_gpg-error};${dependency_sodium};${dependency_plist-2.0};${dependency_avcodec};${dependency_avutil};ws2_32;iphlpapi;bcrypt")
