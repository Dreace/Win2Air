cmake_minimum_required(VERSION 3.25)
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "App build and validation require native Windows.")
endif()
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(WORKSPACE_ROOT "${APP_ROOT}/.." ABSOLUTE)
if(NOT DEFINED PACKAGES_ROOT)
  set(PACKAGES_ROOT "${APP_ROOT}/out/packages")
endif()
if(NOT DEFINED DEPENDENCY_PREFIX)
  set(DEPENDENCY_PREFIX "$ENV{WIN2AIR_DEPENDENCY_PREFIX}")
endif()
if(NOT DEPENDENCY_PREFIX)
  message(FATAL_ERROR "Pass -DDEPENDENCY_PREFIX=<native dependency prefix> or set WIN2AIR_DEPENDENCY_PREFIX.")
endif()
function(require_file path reason)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "${reason}: ${path}")
  endif()
endfunction()
find_program(VSWHERE vswhere.exe PATHS "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer" REQUIRED NO_CACHE)
execute_process(COMMAND "${VSWHERE}" -latest -products * -version "[18.0,19.0)" -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath OUTPUT_VARIABLE VS_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT VS_ROOT)
  message(FATAL_ERROR "Visual Studio 2026 with native C++ tools is required; PATH lookup alone is insufficient.")
endif()
file(TO_CMAKE_PATH "${VS_ROOT}" VS_ROOT)
set(MSBUILD "${VS_ROOT}/MSBuild/Current/Bin/MSBuild.exe")
set(COMPILER "${VS_ROOT}/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64/cl.exe")
set(SDK_ROOT "$ENV{ProgramFiles\(x86\)}/Windows Kits/10")
file(TO_CMAKE_PATH "${SDK_ROOT}" SDK_ROOT)
set(SDK_TOOLS "${SDK_ROOT}/bin/10.0.26100.0/x64")
require_file("${MSBUILD}" "MSBuild missing")
require_file("${COMPILER}" "Pinned MSVC compiler missing")
require_file("${VS_ROOT}/MSBuild/Microsoft/VC/v180/Platforms/x64/PlatformToolsets/v145/Toolset.props" "v145 toolset missing")
require_file("${VS_ROOT}/Common7/Tools/VsDevCmd.bat" "VS native environment initializer missing")
require_file("${SDK_ROOT}/Include/10.0.26100.0/um/Windows.h" "Pinned Windows SDK headers missing")
foreach(tool makeappx makepri signtool)
  require_file("${SDK_TOOLS}/${tool}.exe" "Windows SDK packaging tool missing")
endforeach()
find_program(JQ jq.exe REQUIRED NO_CACHE)
set(NUGET "${APP_ROOT}/out/bootstrap/nuget.exe")
require_file("${NUGET}" "Restore pinned NuGet CLI 7.0.1 first")
execute_process(COMMAND "${NUGET}" help OUTPUT_VARIABLE nuget_version ERROR_VARIABLE nuget_error RESULT_VARIABLE nuget_result)
if(NOT nuget_result EQUAL 0 OR NOT nuget_version MATCHES "7\\.0\\.1")
  message(FATAL_ERROR "NuGet CLI version check failed: ${nuget_error}")
endif()
require_file("${PACKAGES_ROOT}/Microsoft.Windows.CppWinRT.3.0.260818.1/bin/cppwinrt.exe" "Pinned C++/WinRT tool missing")
require_file("${PACKAGES_ROOT}/Microsoft.WindowsAppSDK.WinUI.2.3.9/build/native/Microsoft.WindowsAppSDK.WinUI.targets" "Pinned WinUI component missing")
require_file("${PACKAGES_ROOT}/Microsoft.WindowsAppSDK.2.5.1/Microsoft.WindowsAppSDK.2.5.1.nupkg" "Pinned Windows App SDK missing")
set(GCC "${WORKSPACE_ROOT}/airplay2-sender-core/out/windows-toolchain/mingw64/bin/gcc.exe")
require_file("${GCC}" "Existing native SDK compiler missing")
execute_process(COMMAND "${GCC}" -dumpfullversion OUTPUT_VARIABLE gcc_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT gcc_version STREQUAL "13.2.0")
  message(FATAL_ERROR "SDK compiler must be GCC 13.2.0; got ${gcc_version}")
endif()
require_file("${DEPENDENCY_PREFIX}/native-validation.json" "Native SDK dependency validation missing")
execute_process(COMMAND "${JQ}" -e ".dependency_tests == \"passed\" and .cross_compiling == false" "${DEPENDENCY_PREFIX}/native-validation.json" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${MSBUILD}" -version -nologo OUTPUT_VARIABLE msbuild_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${APP_ROOT}/out/validation")
file(TO_CMAKE_PATH "${JQ}" JQ)
message(STATUS "Native environment passed: ${VS_ROOT}; SDK 26100; MSVC 14.51.36231; GCC ${gcc_version}")
