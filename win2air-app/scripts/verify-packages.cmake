cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED PACKAGES_ROOT)
  set(PACKAGES_ROOT "${APP_ROOT}/out/packages")
endif()
file(READ "${APP_ROOT}/Win2Air/packages.config" config)
file(READ "${APP_ROOT}/Win2Air/packages.lock.json" lock)
string(REGEX MATCHALL "<package id=\"[^\"]+\" version=\"[^\"]+\"" packages "${config}")
if(NOT packages)
  message(FATAL_ERROR "Package configuration contains no dependencies.")
endif()
foreach(package IN LISTS packages)
  string(REGEX MATCH "id=\"([^\"]+)\" version=\"([^\"]+)\"" ignored "${package}")
  set(id "${CMAKE_MATCH_1}")
  set(version "${CMAKE_MATCH_2}")
  string(JSON resolved GET "${lock}" dependencies "native,Version=v0.0" "${id}" resolved)
  if(NOT resolved STREQUAL version)
    message(FATAL_ERROR "NuGet lock version differs from packages.config: ${id}")
  endif()
  if(NOT EXISTS "${PACKAGES_ROOT}/${id}.${version}/${id}.${version}.nupkg")
    message(FATAL_ERROR "Pinned package archive missing: ${id}.${version}")
  endif()
endforeach()
message(STATUS "NuGet dependency versions and restored packages verified.")
