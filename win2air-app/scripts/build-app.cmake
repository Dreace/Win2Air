cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED CONFIGURATION)
  set(CONFIGURATION Debug)
endif()
if(NOT CONFIGURATION MATCHES "^(Debug|Release)$")
  message(FATAL_ERROR "CONFIGURATION must be Debug or Release.")
endif()
set(PACKAGE_IDENTITY_NAME "Win2Air.Desktop")
set(PACKAGE_IDENTITY_PUBLISHER "CN=Win2Air Development")
set(PACKAGE_PUBLISHER_DISPLAY_NAME "Win2Air")
set(STORE_PACKAGE FALSE)
if(PACKAGE AND NOT VALIDATE_INSTALL AND
   (NOT "$ENV{MSSTORE_PACKAGE_NAME}" STREQUAL "" OR NOT "$ENV{MSSTORE_PUBLISHER}" STREQUAL ""))
  if("$ENV{MSSTORE_PACKAGE_NAME}" STREQUAL "" OR "$ENV{MSSTORE_PUBLISHER}" STREQUAL "" OR
     "$ENV{MSSTORE_PUBLISHER_DISPLAY_NAME}" STREQUAL "")
    message(FATAL_ERROR "Store packaging requires MSSTORE_PACKAGE_NAME, MSSTORE_PUBLISHER and MSSTORE_PUBLISHER_DISPLAY_NAME.")
  endif()
  set(STORE_PACKAGE TRUE)
  set(PACKAGE_IDENTITY_NAME "$ENV{MSSTORE_PACKAGE_NAME}")
  set(PACKAGE_IDENTITY_PUBLISHER "$ENV{MSSTORE_PUBLISHER}")
  set(PACKAGE_PUBLISHER_DISPLAY_NAME "$ENV{MSSTORE_PUBLISHER_DISPLAY_NAME}")
endif()
if(NOT DEFINED SDK_DLL)
  set(sender_preset windows-app-dll)
  if(CONFIGURATION STREQUAL "Release" AND NOT TESTS_ONLY)
    set(sender_preset windows-app-dll-release)
  endif()
  set(SDK_DLL "${APP_ROOT}/../airplay2-sender-core/out/${sender_preset}/airplay2_sender.dll")
endif()
if(PREPARE_ONLY AND NOT EXISTS "${SDK_DLL}")
  message(FATAL_ERROR "Build the native sender DLL before building the App.")
endif()
if(PREPARE_ONLY)
  if(NOT EXISTS "${SDK_TOOLS}/makepri.exe")
    message(FATAL_ERROR "Visual Studio must supply the selected Windows SDK resource tools.")
  endif()
else()
  set(NUGET_BOOTSTRAP "${APP_ROOT}/out/bootstrap/nuget.exe")
  set(NUGET_RESTORED "${APP_ROOT}/out/packages/.restored")
  if(NOT EXISTS "${NUGET_RESTORED}")
    file(MAKE_DIRECTORY "${APP_ROOT}/out/bootstrap")
    if(NOT EXISTS "${NUGET_BOOTSTRAP}")
      file(DOWNLOAD "https://dist.nuget.org/win-x86-commandline/v7.0.1/nuget.exe" "${NUGET_BOOTSTRAP}"
        EXPECTED_HASH SHA256=8ddc8cc04298fa08277efdca35373eb158f0c95f5bb1b15efcab2b62952028f6 TLS_VERIFY ON STATUS download_result)
      list(GET download_result 0 code)
      if(NOT code EQUAL 0)
        message(FATAL_ERROR "Pinned NuGet download failed: ${download_result}")
      endif()
    endif()
    execute_process(COMMAND "${NUGET_BOOTSTRAP}" install "${APP_ROOT}/Win2Air/packages.config" -OutputDirectory "${APP_ROOT}/out/packages" -Source https://api.nuget.org/v3/index.json -NonInteractive -DirectDownload COMMAND_ERROR_IS_FATAL ANY)
    file(WRITE "${NUGET_RESTORED}" "packages.config restored\n")
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/check-environment.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/verify-packages.cmake")
endif()
file(MAKE_DIRECTORY "${APP_ROOT}/out")
file(MAKE_DIRECTORY "${APP_ROOT}/out/validation")
set(BUILD_PROJECT "${APP_ROOT}/Win2Air.sln")
if(TESTS_ONLY)
  if(PACKAGE OR VALIDATE_INSTALL)
    message(FATAL_ERROR "TESTS_ONLY cannot package or install the App.")
  endif()
  set(BUILD_PROJECT "${APP_ROOT}/tests/Win2Air.Tests.vcxproj")
endif()
if(NOT PREPARE_ONLY)
  # MSBuild runs inside the Visual Studio developer environment; generating
  # the short batch wrapper keeps the quoting of the spaced tool paths exact.
  string(REPLACE "/" "\\" VSCMD_ROOT "${VS_ROOT}")
  string(REPLACE "/" "\\" VSCMD_PROJECT "${BUILD_PROJECT}")
  set(BUILD_BATCH "${APP_ROOT}/out/build-native-${CONFIGURATION}.cmd")
  file(WRITE "${BUILD_BATCH}"
"call \"${VSCMD_ROOT}\\Common7\\Tools\\VsDevCmd.bat\" -no_logo -arch=x64 -host_arch=x64 -vcvars_ver=14.51
if errorlevel 1 exit /b 1
\"${VSCMD_ROOT}\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${VSCMD_PROJECT}\" /m /nologo /p:Configuration=${CONFIGURATION} /p:Platform=x64 /verbosity:minimal
exit /b %errorlevel%
")
  execute_process(COMMAND cmd.exe /c "${BUILD_BATCH}"
    OUTPUT_FILE "${APP_ROOT}/out/build-${CONFIGURATION}.log" ERROR_FILE "${APP_ROOT}/out/build-${CONFIGURATION}.log" RESULT_VARIABLE build_result)
  if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "Native MSBuild failed; see out/build-${CONFIGURATION}.log")
  endif()
  set(TEST_EXE "${APP_ROOT}/out/tests/${CONFIGURATION}/Win2Air.Tests.exe")
  execute_process(COMMAND "${TEST_EXE}" --sender-abi "${SDK_DLL}" COMMAND_ERROR_IS_FATAL ANY)
  if(TESTS_ONLY)
    message(STATUS "Native console tests compiled without App resources or packaging.")
    return()
  endif()
  if(NOT PACKAGE AND NOT VALIDATE_INSTALL)
    message(STATUS "Native build completed with run resources prepared by MSBuild.")
    return()
  endif()
endif()
set(BIN_ROOT "${APP_ROOT}/out/bin/${CONFIGURATION}")
if(NOT EXISTS "${BIN_ROOT}/airplay2_sender.dll" OR "${SDK_DLL}" IS_NEWER_THAN "${BIN_ROOT}/airplay2_sender.dll")
  file(COPY "${SDK_DLL}" DESTINATION "${BIN_ROOT}")
endif()
function(prepare_resources)
  set(resource_zh "${APP_ROOT}/resources/Strings/zh-CN/Resources.resw")
  set(resource_en "${APP_ROOT}/resources/Strings/en-US/Resources.resw")
  set(resource_index Application)
  if(PACKAGE OR VALIDATE_INSTALL)
    set(resource_index "${PACKAGE_IDENTITY_NAME}")
  endif()
  set(RESOURCE_ROOT "${APP_ROOT}/out/resources/${CONFIGURATION}/${resource_index}")
  set(resource_cache "${APP_ROOT}/out/resources/${CONFIGURATION}/${resource_index}.pri")
  set(resource_inputs "${resource_zh};${resource_en};${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  file(GLOB framework_pri "${BIN_ROOT}/*.pri")
  list(REMOVE_ITEM framework_pri "${BIN_ROOT}/resources.pri")
  list(APPEND resource_inputs ${framework_pri})
  set(cache_current TRUE)
  if(NOT EXISTS "${resource_cache}")
    set(cache_current FALSE)
  endif()
  foreach(input IN LISTS resource_inputs)
    if(NOT EXISTS "${input}")
      message(FATAL_ERROR "Resource input is missing: ${input}")
    endif()
    if("${input}" IS_NEWER_THAN "${resource_cache}")
      set(cache_current FALSE)
    endif()
  endforeach()
  set(input_list "${resource_cache}.inputs")
  if(EXISTS "${input_list}")
    file(READ "${input_list}" previous_inputs)
  else()
    set(previous_inputs "")
  endif()
  if(cache_current AND previous_inputs STREQUAL resource_inputs)
    file(COPY_FILE "${resource_cache}" "${BIN_ROOT}/resources.pri" ONLY_IF_DIFFERENT)
    message(STATUS "Resource index is current: ${resource_index}")
    return()
  endif()
  file(MAKE_DIRECTORY "${RESOURCE_ROOT}")
  file(COPY "${APP_ROOT}/resources/Strings" DESTINATION "${RESOURCE_ROOT}")
  file(GLOB framework_pri "${BIN_ROOT}/*.pri")
  list(REMOVE_ITEM framework_pri "${BIN_ROOT}/resources.pri")
  if(NOT framework_pri)
    message(FATAL_ERROR "Self-contained WinUI runtime resource indexes are missing.")
  endif()
  file(GLOB previous_framework_pri "${RESOURCE_ROOT}/*.pri")
  if(previous_framework_pri)
    file(REMOVE ${previous_framework_pri})
  endif()
  file(COPY ${framework_pri} DESTINATION "${RESOURCE_ROOT}")
  execute_process(COMMAND "${SDK_TOOLS}/makepri.exe" createconfig /cf "${RESOURCE_ROOT}/priconfig.xml" /dq zh-CN /pv 10.0.0 /o
    OUTPUT_FILE "${APP_ROOT}/out/validation/resources-config-${CONFIGURATION}.log" COMMAND_ERROR_IS_FATAL ANY)
  file(READ "${RESOURCE_ROOT}/priconfig.xml" pri_config)
  string(REGEX REPLACE "<autoResourcePackage[^>]*/>" "" pri_config "${pri_config}")
  file(WRITE "${RESOURCE_ROOT}/priconfig.xml" "${pri_config}")
  execute_process(COMMAND "${SDK_TOOLS}/makepri.exe" new /pr "${RESOURCE_ROOT}" /cf "${RESOURCE_ROOT}/priconfig.xml" /of "${resource_cache}" /in "${resource_index}" /o
    OUTPUT_FILE "${APP_ROOT}/out/validation/resources-build-${CONFIGURATION}.log" COMMAND_ERROR_IS_FATAL ANY)
  file(WRITE "${input_list}" "${resource_inputs}")
  file(COPY_FILE "${resource_cache}" "${BIN_ROOT}/resources.pri" ONLY_IF_DIFFERENT)
endfunction()
prepare_resources()
if(NOT PACKAGE AND NOT VALIDATE_INSTALL)
  message(STATUS "Native App compiled. Use PACKAGE=ON when an MSIX is required.")
  return()
endif()
set(BIN_ROOT "${APP_ROOT}/out/bin/${CONFIGURATION}")
set(PAYLOAD "${APP_ROOT}/out/msix/${CONFIGURATION}/payload")
set(msix_root "${APP_ROOT}/out/msix")
cmake_path(IS_PREFIX msix_root "${PAYLOAD}" NORMALIZE payload_is_scoped)
if(NOT payload_is_scoped OR PAYLOAD STREQUAL msix_root)
  message(FATAL_ERROR "MSIX payload directory must remain inside the App output directory.")
endif()
file(REMOVE_RECURSE "${PAYLOAD}")
file(MAKE_DIRECTORY "${PAYLOAD}")
file(GLOB_RECURSE payload_files LIST_DIRECTORIES false RELATIVE "${BIN_ROOT}" "${BIN_ROOT}/*")
foreach(path IN LISTS payload_files)
  # ML initialization is disabled in both the native app and Charts. Older
  # output directories can still contain these optional SDK runtime assets.
  if(NOT path MATCHES "\\.(pdb|ilk|lib|exp)$" AND
     NOT path MATCHES "(^|/)(onnxruntime|DirectML|Microsoft\\.Windows\\.AI\\.MachineLearning)\\.dll$")
    get_filename_component(relative_dir "${path}" DIRECTORY)
    file(COPY "${BIN_ROOT}/${path}" DESTINATION "${PAYLOAD}/${relative_dir}")
  endif()
endforeach()
set(CRT_ROOT "${VS_ROOT}/VC/Redist/MSVC/14.51.36231/x64/Microsoft.VC145.CRT")
require_file("${CRT_ROOT}/msvcp140.dll" "Pinned redistributable C++ runtime missing")
require_file("${CRT_ROOT}/vcruntime140.dll" "Pinned redistributable C runtime missing")
file(GLOB runtime_files "${CRT_ROOT}/*.dll")
file(COPY ${runtime_files} DESTINATION "${PAYLOAD}")
foreach(field PACKAGE_IDENTITY_NAME PACKAGE_IDENTITY_PUBLISHER PACKAGE_PUBLISHER_DISPLAY_NAME)
  string(REPLACE "&" "&amp;" ${field} "${${field}}")
  string(REPLACE "\"" "&quot;" ${field} "${${field}}")
  string(REPLACE "<" "&lt;" ${field} "${${field}}")
  string(REPLACE ">" "&gt;" ${field} "${${field}}")
endforeach()
configure_file("${APP_ROOT}/packaging/Package.appxmanifest" "${PAYLOAD}/AppxManifest.xml" @ONLY)
file(COPY "${APP_ROOT}/resources/Assets" DESTINATION "${PAYLOAD}")
set(TEST_EXE "${APP_ROOT}/out/tests/${CONFIGURATION}/Win2Air.Tests.exe")
execute_process(COMMAND "${TEST_EXE}" --assets "${PAYLOAD}/Assets" COMMAND_ERROR_IS_FATAL ANY)
if(EXISTS "${SDK_DLL}")
  file(COPY "${SDK_DLL}" DESTINATION "${PAYLOAD}")
  execute_process(COMMAND "${TEST_EXE}" --sender-abi "${PAYLOAD}/airplay2_sender.dll"
    OUTPUT_FILE "${APP_ROOT}/out/validation/packaged-abi-${CONFIGURATION}.log" ERROR_VARIABLE abi_error RESULT_VARIABLE abi_result)
  if(NOT abi_result EQUAL 0)
    message(FATAL_ERROR "Packaged sender DLL ABI validation failed: ${abi_error}")
  endif()
endif()
set(MSIX "${APP_ROOT}/out/msix/${CONFIGURATION}/Win2Air.msix")
execute_process(COMMAND "${SDK_TOOLS}/makeappx.exe" pack /d "${PAYLOAD}" /p "${MSIX}" /o
  OUTPUT_FILE "${APP_ROOT}/out/validation/makeappx-${CONFIGURATION}.stdout.log" ERROR_FILE "${APP_ROOT}/out/validation/makeappx-${CONFIGURATION}.stderr.log" RESULT_VARIABLE pack_result)
if(NOT pack_result EQUAL 0)
  message(FATAL_ERROR "MSIX pack failed (${pack_result}); see out/validation/makeappx-${CONFIGURATION} logs.")
endif()
if(STORE_PACKAGE)
  message(STATUS "Microsoft Store MSIX built: ${MSIX}; the Store supplies the distribution signature.")
  return()
endif()
find_program(WINDOWS_POWERSHELL powershell.exe PATHS "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0" REQUIRED NO_CACHE)
set(install_argument "")
if(VALIDATE_INSTALL)
  set(install_argument -Install)
endif()
execute_process(COMMAND "${WINDOWS_POWERSHELL}" -NoProfile -ExecutionPolicy Bypass -File "${CMAKE_CURRENT_LIST_DIR}/package-validation.ps1" -Configuration "${CONFIGURATION}" -SdkTools "${SDK_TOOLS}" ${install_argument}
  OUTPUT_FILE "${APP_ROOT}/out/validation/package-${CONFIGURATION}.stdout.log" ERROR_FILE "${APP_ROOT}/out/validation/package-${CONFIGURATION}.stderr.log" RESULT_VARIABLE sign_result)
if(NOT sign_result EQUAL 0)
  message(FATAL_ERROR "MSIX signing/validation failed (${sign_result}); see out/validation/package-${CONFIGURATION} logs.")
endif()
message(STATUS "Native App and signed MSIX built: ${MSIX}")
