cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SDK_ROOT "${APP_ROOT}/../airplay2-sender-core")
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Build the Windows sender DLL natively on Windows.")
endif()
set(dependency_argument "")
if(NOT DEFINED DEPENDENCY_PREFIX AND DEFINED ENV{WIN2AIR_DEPENDENCY_PREFIX})
  set(DEPENDENCY_PREFIX "$ENV{WIN2AIR_DEPENDENCY_PREFIX}")
endif()
if(DEFINED DEPENDENCY_PREFIX)
  set(dependency_argument "-DAIRPLAY2_WINDOWS_DEPENDENCIES=${DEPENDENCY_PREFIX}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --preset windows-app-dll -DCMAKE_EXPORT_COMPILE_COMMANDS=ON ${dependency_argument} WORKING_DIRECTORY "${SDK_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset windows-app-dll WORKING_DIRECTORY "${SDK_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
set(SDK_DLL "${SDK_ROOT}/out/windows-app-dll/airplay2_sender.dll")
file(MAKE_DIRECTORY "${APP_ROOT}/out/validation")
execute_process(COMMAND "${SDK_ROOT}/out/windows-toolchain/mingw64/bin/objdump.exe" -p "${SDK_DLL}" OUTPUT_VARIABLE exports COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${APP_ROOT}/out/validation/sender-exports.log" "${exports}")
string(REGEX MATCHALL "\n[\t ]*\\[[ ]*[0-9]+\\] [A-Za-z_][A-Za-z_0-9]*" public_symbols "${exports}")
foreach(entry IN LISTS public_symbols)
    if(NOT entry MATCHES "sender_(get_abi|create_ex|create|connect|submit|submit_timed|probe_target|get_timing|get_snapshot|set_volume|get_receiver_volume|take_media_command|set_now_playing|set_presentation|retarget_presentation|flush|end|poll|get_state|destroy|validate_target)$")
    message(FATAL_ERROR "Unexpected public DLL export: ${entry}")
  endif()
endforeach()
list(LENGTH public_symbols export_count)
if(NOT export_count EQUAL 21)
  message(FATAL_ERROR "The sender DLL must contain the full explicit C ABI export set.")
endif()
message(STATUS "Windows sender DLL built with the required C ABI exports.")
