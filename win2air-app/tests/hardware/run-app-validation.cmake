cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT ENABLE_HARDWARE)
  message(FATAL_ERROR "Actual App playback requires explicit ENABLE_HARDWARE=ON.")
endif()
foreach(input TARGET_HOST TARGET_PORT INPUT_WAVE AUMID)
  if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
    message(FATAL_ERROR "Actual App playback requires ${input}.")
  endif()
endforeach()
if(NOT TARGET_PORT MATCHES "^[0-9]+$" OR TARGET_PORT LESS 1 OR TARGET_PORT GREATER 65535 OR NOT EXISTS "${INPUT_WAVE}")
  message(FATAL_ERROR "Actual App playback requires a valid port and existing rendered input.")
endif()
if(NOT DEFINED CONFIGURATION)
  set(CONFIGURATION Debug)
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run_root "${APP_ROOT}/out/validation/system-audio/${run_id}")
file(MAKE_DIRECTORY "${run_root}")
cmake_path(ABSOLUTE_PATH INPUT_WAVE NORMALIZE OUTPUT_VARIABLE wave)
set(config "${run_root}/input.json")
set(report "${run_root}/app-result.json")
if(NOT DEFINED INITIAL_BASE_MS)
  set(INITIAL_BASE_MS 1000)
endif()
if(NOT DEFINED INITIAL_OFFSET_MS)
  set(INITIAL_OFFSET_MS 0)
endif()
file(WRITE "${config}" "{\"enable_hardware\":true,\"run_id\":\"${run_id}\",\"host\":\"${TARGET_HOST}\",\"port\":${TARGET_PORT},\"wave\":\"${wave}\",\"report\":\"${report}\",\"base_ms\":${INITIAL_BASE_MS},\"offset_ms\":${INITIAL_OFFSET_MS}}\n")
execute_process(COMMAND "${APP_ROOT}/out/tests/${CONFIGURATION}/Win2Air.Tests.exe" --activate-validation "${AUMID}" "${config}"
  RESULT_VARIABLE result OUTPUT_FILE "${run_root}/activation.stdout.log" ERROR_FILE "${run_root}/activation.stderr.log" TIMEOUT 85)
message(STATUS "Actual App system audio evidence: ${run_root}")
if(NOT result EQUAL 0 OR NOT EXISTS "${report}")
  message(FATAL_ERROR "Actual App system audio validation failed; preserve activation and App reports.")
endif()
file(READ "${report}" evidence)
string(JSON status GET "${evidence}" status)
if(NOT status STREQUAL "awaiting_observation")
  message(FATAL_ERROR "Actual App system audio validation did not finish automated checks: ${status}.")
endif()
message(STATUS "Automated App path completed. Current listening observation is required for acceptance.")
