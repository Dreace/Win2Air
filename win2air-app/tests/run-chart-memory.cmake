cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED CONFIGURATION)
  set(CONFIGURATION Debug)
endif()
if(NOT CONFIGURATION MATCHES "^(Debug|Release)$")
  message(FATAL_ERROR "CONFIGURATION must be Debug or Release.")
endif()
find_program(DOTNET dotnet REQUIRED)
execute_process(COMMAND "${DOTNET}" build
  "${APP_ROOT}/tests/Win2Air.Charts.Tests.csproj" -c "${CONFIGURATION}"
  -p:Platform=x64 -p:NuGetAudit=false --ignore-failed-sources --nologo -v:minimal
  TIMEOUT 180 COMMAND_ERROR_IS_FATAL ANY)
set(TEST_ROOT "${APP_ROOT}/tests/bin/x64/${CONFIGURATION}/net10.0-windows10.0.26100.0/win-x64")
set(REPORT "${APP_ROOT}/out/chart-memory-${CONFIGURATION}.json")
file(REMOVE "${REPORT}")
execute_process(COMMAND "${TEST_ROOT}/Win2Air.Charts.Tests.exe" "${REPORT}"
  TIMEOUT 300 COMMAND_ERROR_IS_FATAL ANY)
file(READ "${REPORT}" RESULT)
string(JSON STATUS GET "${RESULT}" status)
if(NOT STATUS STREQUAL "passed")
  message(FATAL_ERROR "Chart memory test failed: ${RESULT}")
endif()
message(STATUS "Chart refresh, range switching and allocation regression passed: ${REPORT}")
set(NAVIGATION_REPORT "${APP_ROOT}/out/chart-navigation-memory-${CONFIGURATION}.json")
file(REMOVE "${NAVIGATION_REPORT}")
execute_process(COMMAND "${TEST_ROOT}/Win2Air.Charts.Tests.exe" "${NAVIGATION_REPORT}" --navigation
  TIMEOUT 120 COMMAND_ERROR_IS_FATAL ANY)
file(READ "${NAVIGATION_REPORT}" NAVIGATION_RESULT)
string(JSON NAVIGATION_STATUS GET "${NAVIGATION_RESULT}" status)
if(NOT NAVIGATION_STATUS STREQUAL "passed")
  message(FATAL_ERROR "Chart navigation memory test failed: ${NAVIGATION_RESULT}")
endif()
message(STATUS "Idle chart page switching regression passed: ${NAVIGATION_REPORT}")
