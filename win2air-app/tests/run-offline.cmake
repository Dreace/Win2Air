cmake_minimum_required(VERSION 3.25)
get_filename_component(APP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED CONFIGURATION)
  set(CONFIGURATION Debug)
endif()
if(NOT CONFIGURATION MATCHES "^(Debug|Release)$")
  message(FATAL_ERROR "CONFIGURATION must be Debug or Release.")
endif()
set(TEST_ROOT "${APP_ROOT}/out/tests/${CONFIGURATION}/scratch")
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_nonce)
set(TEST_ROOT "${TEST_ROOT}/${run_nonce}")
function(run name expected_exit)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
  if((expected_exit STREQUAL "success" AND NOT result EQUAL 0) OR
     (expected_exit STREQUAL "failure" AND (result EQUAL 0 OR NOT result MATCHES "^[0-9]+$")))
    message(FATAL_ERROR "${name} failed: ${stdout}${stderr}; exit=${result}")
  endif()
  message(STATUS "${name}: passed")
endfunction()
