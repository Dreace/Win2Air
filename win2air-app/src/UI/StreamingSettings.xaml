<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <TextBlock x:Name="StreamingTitle" Visibility="Collapsed" />
  <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="LatencyModeLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="LatencyMode" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
  <Grid x:Name="CustomLatencyRow" Visibility="Collapsed" Style="{StaticResource AirSettingRowStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="CustomLatencyLabel" Style="{StaticResource AirSettingLabelStyle}" />
    <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Slider VerticalAlignment="Center" x:Name="CustomLatency" Minimum="20" Maximum="5000" StepFrequency="1" SmallChange="1" LargeChange="10" />
      <NumberBox x:Name="CustomLatencyValue" Grid.Column="1" MinWidth="112" VerticalAlignment="Center" Minimum="20" Maximum="5000" SmallChange="1" SpinButtonPlacementMode="Compact" ValidationMode="Disabled" />
      <Button x:Name="ApplyCustomLatency" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AirActionStyle}" />
    </Grid>
  </Grid>
  <TextBlock x:Name="LatencyFieldError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource AirErrorBrush}" />
  <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SilenceTimeoutLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="SilenceTimeout" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
  <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="StandbyDisconnectLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="StandbyDisconnect" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
  <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="AutoReconnectLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch MinWidth="0" x:Name="AutoReconnect" Grid.Column="1" HorizontalAlignment="Right" /></Grid>
</StackPanel>
