<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource AirBackgroundBrush}" Padding="24">
  <Grid ColumnSpacing="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <ListView x:Name="SettingsCategory" SelectionMode="Single" HorizontalContentAlignment="Stretch">
      <ListViewItem x:Name="GeneralCategory" Tag="general" Padding="12" />
      <ListViewItem x:Name="AudioCategory" Tag="audio" Padding="12" />
      <ListViewItem x:Name="StreamingCategory" Tag="streaming" Padding="12" />
      <ListViewItem x:Name="ReceiversCategory" Tag="receivers" Padding="12" />
      <ListViewItem x:Name="AboutCategory" Tag="about" Padding="12" />
    </ListView>
    <ScrollViewer x:Name="GeneralPanel" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16">
        <Border Style="{StaticResource AirCardStyle}"><StackPanel Spacing="12">
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StartupEnabledLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch VerticalAlignment="Center" MinWidth="0" x:Name="StartupEnabled" Grid.Column="1" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StartupMinimizedLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch VerticalAlignment="Center" MinWidth="0" x:Name="StartupMinimized" Grid.Column="1" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="RestorePreviousLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch VerticalAlignment="Center" MinWidth="0" x:Name="RestorePrevious" Grid.Column="1" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="CloseToTrayLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch VerticalAlignment="Center" MinWidth="0" x:Name="CloseToTray" Grid.Column="1" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SettingsThemeLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="SettingsTheme" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SettingsLanguageLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="SettingsLanguage" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SettingsLogLevelLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="SettingsLogLevel" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
          <TextBlock x:Name="StartupStatus" Style="{StaticResource AirSecondaryTextStyle}" Margin="0,8,0,0" />
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="AudioPanel" Grid.Column="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="20">
        <Border Style="{StaticResource AirCardStyle}"><StackPanel Spacing="16">
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SettingsSourceLabel" Style="{StaticResource AirSettingLabelStyle}" /><ComboBox x:Name="SettingsSource" Grid.Column="1" Style="{StaticResource AirSettingComboStyle}" /></Grid>
          <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="SettingsLocalLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch MinWidth="0" x:Name="SettingsLocal" Grid.Column="1" HorizontalAlignment="Right" /></Grid>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="StreamingPanel" Grid.Column="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="20"><Border Style="{StaticResource AirCardStyle}"><ContentControl x:Name="StreamingSettingsContent" HorizontalContentAlignment="Stretch" /></Border><Border Style="{StaticResource AirCardStyle}"><Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ReceiverMediaControlLabel" Style="{StaticResource AirSettingLabelStyle}" /><ToggleSwitch x:Name="ReceiverMediaControl" Grid.Column="1" VerticalAlignment="Center" MinWidth="0" /></Grid></Border></StackPanel>
    </ScrollViewer>
    <Grid x:Name="ReceiversPanel" Grid.Column="1" Visibility="Collapsed">
      <ContentControl x:Name="ReceiverManagementContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <ScrollViewer x:Name="AboutPanel" Grid.Column="1" Visibility="Collapsed" MaxWidth="1000" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16">
        <Border Style="{StaticResource AirCardStyle}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Win2Air" Style="{StaticResource AirSectionStyle}" />
              <TextBlock x:Name="AboutVersion" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <HyperlinkButton x:Name="AboutRepository" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" MinWidth="0" MinHeight="0">
              <HyperlinkButton.Resources>
                <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="HyperlinkButtonForeground" />
                <StaticResource x:Key="HyperlinkButtonBackgroundPointerOver" ResourceKey="HyperlinkButtonBackground" />
                <StaticResource x:Key="HyperlinkButtonBorderBrushPointerOver" ResourceKey="HyperlinkButtonBorderBrush" />
              </HyperlinkButton.Resources>
              <TextBlock x:Name="AboutRepositoryAddress" FontSize="14" TextWrapping="Wrap" />
            </HyperlinkButton>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource AirCardStyle}"><StackPanel Spacing="12"><TextBlock x:Name="AboutDisclaimerTitle" Style="{StaticResource AirSectionStyle}" /><TextBlock x:Name="AboutDisclaimer" TextWrapping="Wrap" /><TextBlock x:Name="AboutApple" TextWrapping="Wrap" /><TextBlock x:Name="AboutMicrosoft" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Style="{StaticResource AirCardStyle}"><StackPanel Spacing="16"><TextBlock x:Name="AboutOpenSource" Style="{StaticResource AirSectionStyle}" /><Grid x:Name="OpenSourceNotices" ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="5*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions></Grid><TextBlock x:Name="AboutOpenSourceTerms" Style="{StaticResource AirSecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
