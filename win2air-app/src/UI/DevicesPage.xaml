<ScrollViewer x:Name="DeviceScroll" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource AirBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
  <StackPanel x:Name="DeviceColumn" Spacing="24" HorizontalAlignment="Left">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"><CheckBox x:Name="ShowHidden" VerticalAlignment="Center" /><Button x:Name="RefreshReceivers" Style="{StaticResource AirActionStyle}" /></StackPanel>
          <StackPanel x:Name="ReceiverCards" Spacing="12" />
          <TextBlock x:Name="Availability" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Expander x:Name="ManualReceiverOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="12">
            <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="HostLabel" Style="{StaticResource AirSettingLabelStyle}" /><TextBox VerticalAlignment="Center" x:Name="Host" Grid.Column="1" HorizontalAlignment="Stretch" /></Grid>
            <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="PortLabel" Style="{StaticResource AirSettingLabelStyle}" />
              <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <NumberBox VerticalAlignment="Center" x:Name="Port" Minimum="1" Maximum="65535" Value="7000" SpinButtonPlacementMode="Compact" />
                <Button x:Name="AddReceiver" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AirActionStyle}" />
              </Grid>
            </Grid>
            <TextBlock x:Name="PortError" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource AirErrorBrush}" />
          </StackPanel>
        </Expander>
  </StackPanel>
</ScrollViewer>
