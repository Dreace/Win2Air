<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ReceiverCard" Padding="16" CornerRadius="12" BorderThickness="1" Background="{ThemeResource AirSurfaceBrush}" BorderBrush="{ThemeResource AirBorderBrush}">
  <StackPanel Spacing="12">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="10" Height="10" VerticalAlignment="Center">
        <Ellipse x:Name="IndicatorIdle" Width="10" Height="10" Fill="{ThemeResource AirSecondaryBrush}" />
        <Ellipse x:Name="IndicatorLive" Width="10" Height="10" Fill="{ThemeResource AirSuccessBrush}" Visibility="Collapsed" />
        <Ellipse x:Name="IndicatorBusy" Width="10" Height="10" Fill="{ThemeResource AirWarningBrush}" Visibility="Collapsed" />
        <Ellipse x:Name="IndicatorFailed" Width="10" Height="10" Fill="{ThemeResource AirErrorBrush}" Visibility="Collapsed" />
      </Grid>
      <StackPanel x:Name="ReceiverHeading" Grid.Column="1" Spacing="2" VerticalAlignment="Center" Background="Transparent">
        <TextBlock x:Name="ReceiverName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="ReceiverDetail" TextWrapping="Wrap" Foreground="{ThemeResource AirSecondaryBrush}" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ReceiverRecovery" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource AirErrorBrush}" />
    <Expander x:Name="ReceiverDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
        <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="ReceiverEditNameLabel" Style="{StaticResource AirSettingLabelStyle}" />
          <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox VerticalAlignment="Center" x:Name="ReceiverEditName" />
            <Button x:Name="ReceiverNameSave" Grid.Column="1" Style="{StaticResource AirActionStyle}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
        <StackPanel>
          <CheckBox x:Name="ReceiverFavorite" />
          <CheckBox x:Name="ReceiverHidden" />
          <CheckBox x:Name="ReceiverAutoConnect" />
        </StackPanel>
        <StackPanel x:Name="ReceiverEndpointEditor" Spacing="8" Visibility="Collapsed">
        <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="ReceiverHostLabel" Style="{StaticResource AirSettingLabelStyle}" /><TextBox VerticalAlignment="Center" x:Name="ReceiverHost" Grid.Column="1" HorizontalAlignment="Stretch" /></Grid>
        <Grid Style="{StaticResource AirSettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><TextBlock x:Name="ReceiverPortLabel" Style="{StaticResource AirSettingLabelStyle}" />
          <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <NumberBox VerticalAlignment="Center" x:Name="ReceiverPort" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
            <Button x:Name="ReceiverEndpointSave" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AirActionStyle}" />
          </Grid>
        </Grid>
        </StackPanel>
        <Button x:Name="ReceiverResetLatency" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ReceiverDelete" />
          <Button x:Name="ReceiverForget" />
        </StackPanel>
      </StackPanel>
    </Expander>
  </StackPanel>
</Border>
