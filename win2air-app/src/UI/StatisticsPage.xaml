<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource AirBackgroundBrush}" Padding="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="StatisticsTitle" FontFamily="Segoe UI Variable" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AirTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" /><Ellipse x:Name="StatisticsStatusDot" Width="8" Height="8" Fill="{ThemeResource AirSuccessBrush}" Visibility="Collapsed" VerticalAlignment="Center" /><TextBlock x:Name="StatisticsStatus" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" /></StackPanel><TextBlock x:Name="StatisticsReceiver" Style="{StaticResource AirSecondaryTextStyle}" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="ExportDiagnostics" Style="{StaticResource AirActionStyle}" /><Button x:Name="CancelDiagnostics" Style="{StaticResource AirActionStyle}" Visibility="Collapsed" /></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="DurationCard" Style="{StaticResource AirCardStyle}" Padding="20"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Clock" Foreground="{ThemeResource AirSecondaryBrush}" /><TextBlock x:Name="DurationLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="DurationValue" Style="{StaticResource AirMetricStyle}" /></StackPanel></Border>
      <Border x:Name="LeadCard" Grid.Column="1" Style="{StaticResource AirCardStyle}" Padding="20"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{ThemeResource AirSecondaryBrush}" VerticalAlignment="Center" /><TextBlock x:Name="LeadLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="LeadValue" Style="{StaticResource AirMetricStyle}" /></StackPanel></Border>
      <Border x:Name="BitrateCard" Grid.Column="2" Style="{StaticResource AirCardStyle}" Padding="20"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Upload" Foreground="{ThemeResource AirSecondaryBrush}" /><TextBlock x:Name="BitrateLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="BitrateValue" Style="{StaticResource AirMetricStyle}" /></StackPanel></Border>
      <Border x:Name="HealthCard" Grid.Column="3" Style="{StaticResource AirCardStyle}" Padding="20"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="FourBars" Foreground="{ThemeResource AirSecondaryBrush}" /><TextBlock x:Name="HealthLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="{ThemeResource AirSuccessBrush}" Visibility="Collapsed" VerticalAlignment="Center" /><TextBlock x:Name="StatisticsHealth" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" /></StackPanel></StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="StatisticsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="StatisticsContent" Spacing="16" HorizontalAlignment="Left">
    <Grid x:Name="StatisticsBody" ColumnSpacing="16" RowSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="BodyPrimary" Width="7*" /><ColumnDefinition x:Name="BodySecondary" Width="3*" /></Grid.ColumnDefinitions>
      <Border x:Name="NetworkHistoryCard" Grid.Row="0" Style="{StaticResource AirCardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="HistoryMetric" HorizontalAlignment="Left" MinWidth="140" />
            <ComboBox x:Name="HistoryWindow" Grid.Column="1" MinWidth="110" />
          </Grid>
          <TextBlock x:Name="HistoryCurrent" Grid.Row="1" Style="{StaticResource AirSecondaryTextStyle}" />
          <ContentControl x:Name="HistoryChart" Grid.Row="2" MinHeight="240" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
        <Border x:Name="NetworkCard" Grid.Column="1" Style="{StaticResource AirCardStyle}" Padding="16"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Globe" Foreground="{ThemeResource AirSecondaryBrush}" /><TextBlock x:Name="NetworkHeading" Style="{StaticResource AirCardHeadingStyle}" VerticalAlignment="Center" /></StackPanel><StackPanel Spacing="4"><Grid x:Name="NetworkBytesRow" ColumnSpacing="16" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NetworkBytesLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /><TextBlock x:Name="NetworkBytesValue" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" IsTextSelectionEnabled="True" /></Grid><Grid x:Name="NetworkPacketsRow" ColumnSpacing="16" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NetworkPacketsLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /><TextBlock x:Name="NetworkPacketsValue" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" IsTextSelectionEnabled="True" /></Grid><Grid x:Name="NetworkRequestsRow" ColumnSpacing="16" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NetworkRequestsLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /><TextBlock x:Name="NetworkRequestsValue" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" IsTextSelectionEnabled="True" /></Grid><Grid x:Name="NetworkPendingRow" ColumnSpacing="16" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NetworkPendingLabel" Style="{StaticResource AirSecondaryTextStyle}" VerticalAlignment="Center" /><TextBlock x:Name="NetworkPendingValue" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" IsTextSelectionEnabled="True" /></Grid></StackPanel></StackPanel></Border>
      <Border x:Name="AudioHistoryCard" Grid.Row="1" Style="{StaticResource AirCardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="AudioHistoryMetric" HorizontalAlignment="Left" MinWidth="140" />
            <ComboBox x:Name="AudioHistoryWindow" Grid.Column="1" MinWidth="110" />
          </Grid>
          <TextBlock x:Name="AudioHistoryCurrent" Grid.Row="1" Style="{StaticResource AirSecondaryTextStyle}" />
          <ContentControl x:Name="AudioHistoryChart" Grid.Row="2" MinHeight="240" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
        <Border x:Name="ConnectionEventsCard" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource AirCardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock x:Name="ConnectionEvents" Style="{StaticResource AirCardHeadingStyle}" /><StackPanel x:Name="ConnectionEventRows" Spacing="8" /></StackPanel></Border>
    <Border x:Name="MetricDetails" Grid.Row="1" Grid.Column="1" Style="{StaticResource AirCardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock x:Name="MetricDetailsHeading" Style="{StaticResource AirCardHeadingStyle}" /><StackPanel x:Name="MetricDetailsRows" Spacing="4" /></StackPanel></Border>
    </Grid>
    <TextBlock x:Name="ExportStatus" Style="{StaticResource AirSecondaryTextStyle}" IsTextSelectionEnabled="True" />
    </StackPanel></ScrollViewer>
</Grid>
