<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="SessionCard" Padding="16" BorderThickness="0,0,0,1" Background="{ThemeResource AirSurfaceBrush}" BorderBrush="{ThemeResource AirBorderBrush}">
    <Grid ColumnSpacing="16" MinHeight="72">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel x:Name="SessionHeading" MinWidth="0" Spacing="4" VerticalAlignment="Center" Background="Transparent">
        <TextBlock x:Name="SessionName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SessionDetail" Style="{StaticResource AirSecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SessionFault" TextWrapping="Wrap" Foreground="{ThemeResource AirErrorBrush}" Visibility="Collapsed" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Grid Width="8" Height="8" VerticalAlignment="Center">
          <Ellipse x:Name="IndicatorIdle" Fill="{ThemeResource AirSecondaryBrush}" /><Ellipse x:Name="IndicatorLive" Fill="{ThemeResource AirSuccessBrush}" Visibility="Collapsed" /><Ellipse x:Name="IndicatorBusy" Fill="{ThemeResource AirWarningBrush}" Visibility="Collapsed" /><Ellipse x:Name="IndicatorFailed" Fill="{ThemeResource AirErrorBrush}" Visibility="Collapsed" />
        </Grid><TextBlock x:Name="SessionStatus" Style="{StaticResource AirSecondaryTextStyle}" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><Button x:Name="SessionConnect" MinWidth="108" Style="{StaticResource AirActionStyle}" /><Button x:Name="SessionDisconnect" MinWidth="108" Style="{StaticResource AirActionStyle}" /></StackPanel>
    </Grid>
  </Border>
</Grid>
